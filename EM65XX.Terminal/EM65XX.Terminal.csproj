<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<AppVersion>1.0.$([System.DateTime]::Now.ToString(yyMM)).$([System.DateTime]::Now.ToString(dd))</AppVersion>
		
		<AssemblyVersion>$(AppVersion)</AssemblyVersion>
		<FileVersion>$(AppVersion)</FileVersion>
		<AssemblyName>em65</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="CommandLineParser" Version="2.9.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\EM65XX.Core\EM65XX.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="examples\extbin\add_decimal">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="examples\extbin\test">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
