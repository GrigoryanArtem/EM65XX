<UserControl
    x:Class="EM65XX.Desktop.View.Controls.MemoryPageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:EM65XX.Desktop.AttachedBehaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:EM65XX.Desktop.View.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:EM65XX.Desktop.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:MemoryPage}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <DataGrid
        behaviors:MemoryGridBehavior.GenerateMemoryColumns="True"
        AutoGenerateColumns="False"
        CanUserAddRows="False"
        FontFamily="Lucida Console"
        FontSize="14"
        HeadersVisibility="Column"
        ItemsSource="{Binding Pages[0].Rows}" />
</UserControl>
