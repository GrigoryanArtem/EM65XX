<UserControl
    x:Class="EM65XX.Desktop.View.Controls.RegisterViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:EM65XX.Desktop.View.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Orientation="Horizontal">


        <TextBlock
            Width="30"
            Padding="0 4"
            VerticalAlignment="Center"
            d:Text="PC"
            TextAlignment="Center" />

        <TextBox
            Margin="8 4"
            Padding="8 4"
            d:Text="1A"
            materialDesign:HintAssist.Hint="HEX"
            Style="{StaticResource MaterialDesignOutlinedTextBox}" />

        <TextBox
            Margin="8 4"
            Padding="8 4"
            d:Text="26"
            materialDesign:HintAssist.Hint="DEC"
            Style="{StaticResource MaterialDesignOutlinedTextBox}" />

        <TextBox
            Margin="8 4"
            Padding="8 4"
            d:Text="00011010"
            materialDesign:HintAssist.Hint="BIN"
            Style="{StaticResource MaterialDesignOutlinedTextBox}" />
    </StackPanel>
</UserControl>
