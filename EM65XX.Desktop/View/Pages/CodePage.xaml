<Page
    x:Class="EM65XX.Desktop.View.Pages.CodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:EM65XX.Desktop.AttachedBehaviors"
    xmlns:controls="clr-namespace:EM65XX.Desktop.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:EM65XX.Desktop.ViewModel"
    Title="CodePage"
    d:DataContext="{d:DesignInstance Type=viewmodel:CodePageViewModel}"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="0 0 0 16"
            DockPanel.Dock="Top"
            Orientation="Horizontal">

            <Button
                Padding="12 8"
                Command="{Binding LoadCommand}"
                Style="{StaticResource MaterialDesignOutlinedButton}">

                <DockPanel LastChildFill="True">
                    <materialDesign:PackIcon Kind="Download" />
                    <TextBlock
                        Margin="4 0 0 0"
                        VerticalAlignment="Center"
                        Text="LOAD" />
                </DockPanel>
            </Button>

            <Border
                Width="1"
                Margin="12 2"
                BorderBrush="LightGray"
                BorderThickness="1" />

            <Button
                Margin="0 0 8 0"
                Padding="12 8"
                Command="{Binding ResetCommand}"
                Style="{StaticResource MaterialDesignOutlinedButton}">

                <DockPanel LastChildFill="True">
                    <materialDesign:PackIcon Kind="Restart" />
                    <TextBlock
                        Margin="4 0 0 0"
                        VerticalAlignment="Center"
                        Text="RESET" />
                </DockPanel>
            </Button>

            <Button
                Margin="0 0 8 0"
                Padding="12 8"
                Command="{Binding RunCommand}"
                Style="{StaticResource MaterialDesignOutlinedButton}">

                <DockPanel LastChildFill="True">
                    <materialDesign:PackIcon Kind="Play" />
                    <TextBlock
                        Margin="4 0 0 0"
                        VerticalAlignment="Center"
                        Text="RUN" />
                </DockPanel>
            </Button>

            <Button
                Margin="0 0 8 0"
                Padding="12 8"
                Command="{Binding StepCommand}"
                Style="{StaticResource MaterialDesignOutlinedButton}">

                <DockPanel LastChildFill="True">
                    <materialDesign:PackIcon Kind="StepForward" />
                    <TextBlock
                        Margin="4 0 0 0"
                        VerticalAlignment="Center"
                        Text="STEP" />
                </DockPanel>
            </Button>
        </StackPanel>

        <avalonEdit:TextEditor
            xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
            x:Name="_textEditor"
            Grid.Row="1"
            Grid.Column="0"
            Background="{DynamicResource MaterialDesignPaper}"
            BorderBrush="Gray"
            BorderThickness="1"
            FontFamily="Consolas"
            HorizontalScrollBarVisibility="Auto"
            ShowLineNumbers="True"
            SyntaxHighlighting="assembler"
            VerticalScrollBarVisibility="Auto">
            <i:Interaction.Behaviors>
                <behaviors:AvalonEditBehavior GiveMeTheText="{Binding AsmCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </i:Interaction.Behaviors>
        </avalonEdit:TextEditor>

        <Border
            Grid.Row="2"
            Grid.ColumnSpan="3"
            Margin="0 12 0 0"
            Padding="0"
            BorderBrush="Gray"
            BorderThickness="1">

            <StackPanel>
                <TextBlock
                    Margin="8 -7"
                    Padding="4 0"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource MaterialDesignPaper}"
                    FontWeight="Bold"
                    Text="OUTPUT" />

                <ScrollViewer Height="150">
                    <TextBox
                        Margin="8 16 8 8"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="Consolas"
                        Style="{x:Null}"
                        Text="{Binding StdErr}" />
                </ScrollViewer>
            </StackPanel>
        </Border>


        <ScrollViewer
            Grid.Row="1"
            Grid.Column="2">

            <StackPanel>
                <TextBlock
                    Margin="0 0 32 12"
                    VerticalAlignment="Center"
                    Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                    Text="INFO" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="4 0"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontStyle="Italic"
                        Text="OP CODE" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="4 0"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontStyle="Italic"
                        Text="MNEMONIC" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="4 0"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontStyle="Italic"
                        Text="MODE" />

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="4 0"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        Text="{Binding OpCode, StringFormat={}{0:X2}}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="4 0"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        Text="{Binding Mnemonic}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="4 0"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        Text="{Binding Mode}" />
                </Grid>

                <TextBlock
                    Margin="0 12 32 12"
                    VerticalAlignment="Center"
                    Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                    Text="REGISTERS" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="4 0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="A" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="4 0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="X" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="4 0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Y" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="4 0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="SP" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="4 0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="PS" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Margin="4 0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="PC" />

                    <controls:RegisterViewModel
                        Grid.Row="0"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        DataContext="{Binding Registers.A}" />

                    <controls:RegisterViewModel
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        DataContext="{Binding Registers.X}" />

                    <controls:RegisterViewModel
                        Grid.Row="2"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        DataContext="{Binding Registers.Y}" />

                    <controls:RegisterViewModel
                        Grid.Row="3"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        DataContext="{Binding Registers.StackPointer}" />

                    <controls:RegisterViewModel
                        Grid.Row="4"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        DataContext="{Binding Registers.ProcessorStatus}" />

                    <TextBox
                        Grid.Row="5"
                        Grid.Column="1"
                        Margin="8 4"
                        Padding="8 4"
                        materialDesign:HintAssist.Hint="HEX"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Registers.ProgramCounter, StringFormat={}{0:X2}}"
                        TextAlignment="Center" />
                </Grid>

                <DockPanel LastChildFill="True">
                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        Command="{Binding AddWatchCommand}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource MaterialDesignIconForegroundButton}"
                        ToolTip="Next page">


                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Kind="Plus" />
                    </Button>

                    <TextBlock
                        Margin="0 12 32 12"
                        VerticalAlignment="Center"
                        Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                        Text="WATCH" />
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Watches}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0 8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>


                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="2 4"
                                    Padding="8 4"
                                    materialDesign:HintAssist.Hint="Address"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding Address, StringFormat={}{0:X4}}" />

                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="2 4"
                                    Padding="8 4"
                                    materialDesign:HintAssist.Hint="Size"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding Size}" />

                                <TextBox
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="2 4"
                                    Padding="8 4"
                                    materialDesign:HintAssist.Hint="Value"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding Value, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="4">
            <StackPanel Margin="0 0 12 0">
                <DockPanel LastChildFill="True">

                    <StackPanel
                        DockPanel.Dock="Right"
                        Orientation="Horizontal">
                        <Button
                            Width="32"
                            Height="32"
                            Command="{Binding ToZeroPageCommand}"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            ToolTip="To zero page">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Kind="FormatHorizontalAlignLeft" />
                        </Button>

                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            Command="{Binding PrevPageCommand}"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            ToolTip="Previous page">

                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Kind="ArrowLeftThin" />
                        </Button>

                        <TextBox
                            Width="75"
                            Margin="8 0"
                            Padding="8 0"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding SelectedPageIndex}"
                            TextAlignment="Center" />

                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            Command="{Binding NextPageCommand}"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            ToolTip="Next page">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Kind="ArrowRightThin" />
                        </Button>

                        <Button
                            Width="32"
                            Height="32"
                            Command="{Binding ToLastPageCommand}"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            ToolTip="To last page">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Kind="FormatHorizontalAlignRight" />
                        </Button>
                    </StackPanel>

                    <TextBlock
                        Margin="0 0 32 0"
                        VerticalAlignment="Center"
                        Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                        Text="MEMORY" />
                </DockPanel>

                <controls:MemoryPageControl
                    VerticalAlignment="Top"
                    DataContext="{Binding SelectedPage}" />

                <TextBlock
                    Margin="0 24 32 12"
                    VerticalAlignment="Center"
                    Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                    Text="STACK" />

                <controls:MemoryPageControl
                    VerticalAlignment="Top"
                    DataContext="{Binding StackPage}" />
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
