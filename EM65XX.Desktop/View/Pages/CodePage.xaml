<Page
    x:Class="EM65XX.Desktop.View.Pages.CodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:EM65XX.Desktop.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:EM65XX.Desktop.View.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:EM65XX.Desktop.ViewModel"
    Title="CodePage"
    d:DataContext="{d:DesignInstance Type=viewmodel:CodePageViewModel}"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="0 0 0 8"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <Button
                Padding="12 8"
                Content="LOAD" />

            <Button
                Margin="4 0"
                Padding="12 8"
                Content="RESET" />

            <Border
                Width="1"
                Margin="8 2"
                BorderBrush="LightGray"
                BorderThickness="1" />

            <Button
                Margin="4 0"
                Padding="12 8"
                Content="RUN" />

            <Button
                Margin="4 0"
                Padding="12 8"
                Content="NEXT" />
        </StackPanel>

        <TextBox
            Grid.Row="1"
            Grid.Column="0"
            Padding="12 8"
            AcceptsReturn="True"
            FontFamily="Lucida Console"
            FontSize="14"
            Text="Some text" />

        <controls:MemoryPageControl
            Grid.Row="1"
            Grid.Column="1"
            VerticalAlignment="Top"
            DataContext="{Binding Ram}" />

    </Grid>
</Page>
